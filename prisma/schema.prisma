// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  phone     String?
  role      String   @default("BUYER")
  emailVerified DateTime?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sellerLeads SellerLead[]
  buyerLeads  BuyerLead[]
  bookings    Booking[]
  inspections Inspection[] @relation("InspectorInspections")
  approvedInspections Inspection[] @relation("ApprovedInspections")
  payments    Payment[]
  activityLogs ActivityLog[]
  conversationsAsBuyer Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  messages     Message[]
  wishlists    Wishlist[]

  @@map("users")
}

model SellerLead {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  
  make           String
  model          String
  variant        String
  vehicleNumber  String
  year           Int
  kmDriven       Int
  warrantyStatus String
  expectedPrice  Float
  description    String?
  photos         String         @default("[]")
  status         String         @default("SUBMITTED")
  scheduledAt    DateTime?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  inspection   Inspection?
  bookings     Booking[]
  
  @@map("seller_leads")
}

model Inspection {
  id             String   @id @default(cuid())
  sellerLeadId   String   @unique
  sellerLead     SellerLead @relation(fields: [sellerLeadId], references: [id])
  
  // Admin & Visual Checks
  ageYears            Int?
  ageMonths           Int?
  kmDriven            Int?
  bodyDamage          String?
  bodyDamagePhoto     String?
  forkDamage          Boolean?
  accidentHistory     String?
  warrantyStatus      String?
  warrantyType        String?
  warrantyExpiry      DateTime?
  partsReplaced       Boolean?
  replacedParts       String?
  adminComments       String?
  
  // Technical & Performance
  batteryCharge      Float?
  batteryHealth      Float?
  batteryVoltage     Float?
  physicalDamage     Boolean?
  brakeSystem        String?
  brakePads          String?
  wheelAlignment     String?
  testDriveRating    Int?
  testDriveNotes     String?
  techComments       String?
  
  // Appraisal
  finalOffer         Float?
  approvedById       String?
  approvedBy         User?    @relation("ApprovedInspections", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  
  // Metadata
  inspectorId        String
  inspector          User     @relation("InspectorInspections", fields: [inspectorId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Relations
  listing            Listing?
  
  @@map("inspections")
}

model Listing {
  id             String         @id @default(cuid())
  inspectionId   String         @unique
  inspection     Inspection     @relation(fields: [inspectionId], references: [id])
  
  title          String
  price          Float
  status         String         @default("AVAILABLE")
  photos         String         @default("[]")
  publishedAt    DateTime?
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  // Relations
  buyerLeads     BuyerLead[]
  bookings       Booking[]
  conversations  Conversation[]
  wishlists      Wishlist[]

  @@map("listings")
}

model BuyerLead {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  
  listingId         String?
  listing           Listing?    @relation(fields: [listingId], references: [id])
  
  brandsInterested  String      @default("[]")
  modelsInterested  String      @default("[]")
  status            String      @default("LEAD_VISIT_SCHEDULED")
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  // Relations
  bookings          Booking[]
  
  @@map("buyer_leads")
}

model Booking {
  id             String      @id @default(cuid())
  type           String
  
  // For seller inspections
  sellerLeadId   String?
  sellerLead     SellerLead? @relation(fields: [sellerLeadId], references: [id])
  
  // For buyer visits
  buyerLeadId    String?
  buyerLead      BuyerLead?  @relation(fields: [buyerLeadId], references: [id])
  
  listingId      String?
  listing        Listing?    @relation(fields: [listingId], references: [id])
  
  scheduledAt    DateTime
  status         String      @default("confirmed")
  
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  // Relations
  payment        Payment?
  
  @@map("bookings")
}

model Payment {
  id             String   @id @default(cuid())
  razorpayOrderId String @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount         Float
  currency       String   @default("INR")
  status         String   @default("created")
  bookingId      String?   @unique
  booking        Booking? @relation(fields: [bookingId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@map("payments")
}

model ActivityLog {
  id             String   @id @default(cuid())
  action         String
  description    String
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  metadata       String?
  createdAt      DateTime @default(now())

  @@map("activity_logs")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
  @@map("wishlists")
}

model Conversation {
  id        String   @id @default(cuid())
  subject   String?
  listingId String?
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id])
  listing  Listing?  @relation(fields: [listingId], references: [id])
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}